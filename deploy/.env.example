# docker compose 가 읽는 운영 설정. 복사해서 .env 로 쓴다 (.env 는 git 에 올리지 않는다).
#   cp .env.example .env
#
# 아래 두 값은 반드시 새로 만든다. 예시 값을 그대로 쓰거나 다른 곳과 공유하지 않는다.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"   # POSTGRES_PASSWORD
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"   # WAFERAI_SECRET_KEY
#
# token_urlsafe 는 영문·숫자·-·_ 만 만든다. DB 비밀번호는 접속 URL 에 그대로 들어가므로
# @ : / 같은 문자가 있으면 주소가 깨진다.

POSTGRES_PASSWORD=
WAFERAI_SECRET_KEY=

# HTTPS 뒤에서는 반드시 true. false 면 로그인 쿠키가 평문으로 오간다.
# true 인데 HTTP 로 접속하면 브라우저가 쿠키를 저장하지 않아 로그인 직후 다시 로그인 화면이 뜬다.
# (localhost 는 예외 — Chrome 은 http://localhost 에서도 보안 쿠키를 받는다)
WAFERAI_COOKIE_SECURE=true

# 추론 백엔드: auto | onnx | torch
# 어느 쪽이 빠른지는 CPU 에 따라 뒤집힌다. 서버에서 재고 고른다:
#   docker compose exec api python -m scripts.benchmark
WAFERAI_BACKEND=auto

# 외부에 여는 포트
WEB_PORT=80
WEB_TLS_PORT=443
