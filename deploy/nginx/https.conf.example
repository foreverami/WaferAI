# WaferAI — HTTPS 설정. 인증서를 받은 뒤 쓴다 (deploy/README.md 의 "HTTPS" 절).
#   sed 's/DOMAIN/실제도메인/g' https.conf.example > https.conf
#   docker compose -f compose.yaml -f compose.https.yaml up -d

# 로그인 · 가입 신청은 IP 당 분당 30회(순간 20회 여유). 비밀번호 자동 대입을 느리게 만든다.
# 공장에서는 한 사무실이 NAT 로 IP 하나를 쓰므로 너무 조이면 교대 시작에 전원이 막힌다 — 그래서
# 넉넉히 두고, 계정 단위 잠금(5회 실패 → 60초~15분)은 앱이 따로 한다.
# conf.d 는 http{} 안에 include 되므로 limit_req_zone 을 여기 둘 수 있다.
limit_req_zone $binary_remote_addr zone=auth_ip:1m rate=30r/m;

server {
    listen 80;
    server_name DOMAIN;

    # 갱신할 때도 인증서 발급 확인은 HTTP 로 온다.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 컨테이너 상태 검사용. 80 은 리다이렉트만 하므로 / 로 검사하면 늘 실패한다.
    location = /nginx-health {
        access_log off;
        return 200;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 10m;
    root /usr/share/nginx/html;
    index index.html;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://api:8000;

    include /etc/nginx/snippets/security-headers.conf;
    # 브라우저가 이후 이 도메인에 HTTP 로 접속하지 않게 한다. 인증서가 확실히 동작한 뒤에 켠다.
    add_header Strict-Transport-Security "max-age=31536000" always;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # 로그인 · 가입 신청만 IP 속도 제한. 정규식 location 이 /api/ 접두 location 보다 먼저 잡힌다.
    location ~ ^/api/auth/(login|register)$ {
        limit_req zone=auth_ip burst=20 nodelay;
        limit_req_status 429;
        error_page 429 = @too_many_requests;
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 화면은 JSON 의 detail 을 그대로 보여 준다. Nginx 기본 HTML 429 는 읽지 못한다.
    location @too_many_requests {
        default_type application/json;
        return 429 '{"detail":"요청이 너무 많습니다. 1분 뒤에 다시 시도하세요"}';
    }

    location /api/ {
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location = /healthz {
        proxy_pass $api_upstream;
        access_log off;
    }

    # location 에서 add_header 를 쓰면 위의 헤더를 물려받지 않으므로 전부 다시 적는다.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
