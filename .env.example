# WaferAI 환경 설정 예시. 복사해서 .env 로 쓴다 (.env 는 git 에 올리지 않는다).
#   cp .env.example .env

# 운영에서는 production 으로. 안전 점검이 강제된다.
WAFERAI_ENV=development

# JWT 서명 키 — 운영 필수, 32바이트 이상.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WAFERAI_SECRET_KEY=

# 개발은 비워두면 로컬 SQLite 를 쓴다. 운영은 PostgreSQL.
#   postgresql+psycopg://waferai:비밀번호@db:5432/waferai
WAFERAI_DATABASE_URL=

# HTTPS 뒤에 둘 때 켠다. 끄면 쿠키가 평문으로 오간다.
WAFERAI_COOKIE_SECURE=false

# 추론 백엔드: auto | onnx | torch
# 어느 쪽이 빠른지는 CPU 아키텍처에 따라 뒤집힌다.
# 서버를 정한 뒤 `python3 -m scripts.benchmark` 로 재고 고른다.
WAFERAI_BACKEND=auto
